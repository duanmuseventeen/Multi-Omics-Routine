Ref:
https://www.10xgenomics.com/support/software/cell-ranger/latest/tutorials/
https://mgi-tech-bioinformatics.github.io/DNBelab_C_Series_HT_scRNA-analysis-software/Document/site/index.html

# -----------------------------------------------------
# 1. cellranger for 10X
# -----------------------------------------------------
# 相关命令，防止命令中断
screen -S meta
screen -ls
screen -r meta
screen -S meta -X quit

# 下载sra文件
nohup prefetch --option-file PRJNA725073.txt --max-size u > PRJNA725073.log &

# 拆分sra文件
./parallel_sra_spilt.sh

# 运行cellranger
cellranger count --help

for i in $(seq 0 5); do
   mv SRR1435214${i}_1.fastq.gz SRR1435214${i}_S1_L001_R1_001.fastq.gz
   mv SRR1435214${i}_2.fastq.gz SRR1435214${i}_S1_L001_R2_001.fastq.gz
done

# code 1
for i in $(seq 0 5); do
   SAMPLE="SRR1435214${i}"
   echo "========================================"
   echo "开始分析样本: ${SAMPLE}"
   echo "开始时间: $(date '+%Y-%m-%d %H:%M:%S')"
   echo "========================================"
   cellranger count \
      --id=${SAMPLE} \
      --create-bam=true \
      --fastqs=~/2.fastq \
      --sample=${SAMPLE} \
      --transcriptome=~/genomeref/10X/refdata-gex-GRCh38-2024-A \
      --localmem=300 > count_${SAMPLE}.log 2>&1 
   echo "----------------------------------------"
   echo "样本 ${SAMPLE} 分析完成"
   echo "结束时间: $(date '+%Y-%m-%d %H:%M:%S')"
   echo "----------------------------------------"
done

# code 2
while read SAMPLE
do
  echo "========================================"
  echo "开始分析样本: ${SAMPLE}"
  echo "开始时间: $(date '+%Y-%m-%d %H:%M:%S')"
  echo "========================================"
  
  cellranger count \
  --id=${SAMPLE} \
  --create-bam=true \
  --fastqs=~/2.fastq \
  --sample=${SAMPLE} \
  --transcriptome=~/genomeref/10X/refdata-gex-GRCh38-2024-A \
  --localmem=300 \
  > count_${SAMPLE}.log 2>&1
  
  echo "----------------------------------------"
  echo "样本 ${SAMPLE} 分析完成"
  echo "结束时间: $(date '+%Y-%m-%d %H:%M:%S')"
  echo "----------------------------------------"

done < samples.txt

# -----------------------------------------------------
# 2. dnbc4tools for MGI/BGI
# -----------------------------------------------------
$dnbc4tools tools mkgtf --ingtf gencode.vM23.primary_assembly.annotation.gtf --output genes.filtered.gtf
$dnbc4tools rna mkref --ingtf genes.filtered.gtf --fasta GRCm38.primary_assembly.genome.fa --threads 10 --species Mus_musculus

touch run_dnbc.sh
vim run_dnbc.sh

#!/bin/bash

for sample in CCL4_1 CCL4_2 CCL4_3 Neu1_Hep_CKO_CCl4_1 Neu1_Hep_CKO_CCl4_2 Neu1_Hep_CKO_CCl4_3; do

   ~/soft/dnbc4tools3.1/dnbc4tools rna run --name "$sample" --fastqs "$sample" --genomeDir ~/genomeref/dnbc4tools/mmu/GRCm39/Mus_musculus --threads 12

done

nohup ./run_dnbc.sh > dnbc.log 2>&1 &









